{
       "openapi": "3.1.0",
       "info": {
              "title": "Pseudo API",
              "version": "v0.1",
              "description": "Minimal example API"
       },
       "paths": {
              "/foo": {
                     "get": {
                            "description": "Foo",
                            "tags": [
                                   "Foo"
                            ],
                            "operationId": "retrieve",
                            "parameters": [],
                            "responses": {
                                   "200": {
                                          "description": "Returns a foo",
                                          "content": {
                                                 "application/json": {
                                                        "schema": {
                                                               "$ref": "#/components/schemas/Foo"
                                                        }
                                                 }
                                          }
                                   }
                            }
                     },
                     "post": {
                            "requestBody": {
                                   "content": {
                                          "application/json": {
                                                 "schema": {
                                                        "$ref": "#/components/schemas/Foo"
                                                 }
                                          }
                                   }
                            },
                            "responses": {
                                   "200": {
                                          "description": "Returns a foo",
                                          "content": {
                                                 "application/json": {
                                                        "schema": {
                                                               "$ref": "#/components/schemas/mobidp.common.Duration"
                                                        }
                                                 }
                                          }
                                   }
                            }
                     }
              },
              "/bar": {
                     "post": {
                            "requestBody": {
                                   "content": {
                                          "application/json": {
                                                 "schema": {
                                                        "$ref": "#/components/schemas/Bar"
                                                 }
                                          }
                                   }
                            },
                            "responses": {
                                   "200": {
                                          "description": "Returns a foo",
                                          "content": {
                                                 "application/json": {
                                                        "schema": {
                                                               "$ref": "#/components/schemas/Baz"
                                                        }
                                                 }
                                          }
                                   }
                            }
                     }
              }
       },
       "components": {
              "schemas": {
                     "mobidp.common.String": {
                            "type": "string"
                     },
                     "mobidp.common.Duration": {
                            "type": "number"
                     },
                     "KStoreValue": {
                            "oneOf": [
                                   {
                                          "$ref": "#/components/schemas/BaseA"
                                   },
                                   {
                                          "$ref": "#/components/schemas/DerivedA1"
                                   },
                                   {
                                          "$ref": "#/components/schemas/DerivedA2"
                                   }
                            ],
                            "discriminator": {
                                   "propertyName": "@type",
                                   "mapping": {
                                          "BaseA$Bean": "#/components/schemas/BaseA",
                                          "DerivedA1$Bean": "#/components/schemas/DerivedA1",
                                          "DerivedA2$Bean": "#/components/schemas/DerivedA2"
                                   }
                            }
                     },
                     "Foo": {
                            "type": "object",
                            "properties": {
                                   "a": {
                                          "type": "string"
                                   },
                                   "b": {
                                          "type": "number"
                                   }
                            }
                     },
                     "Bar": {
                            "type": "object",
                            "allOf": [
                                   {
                                          "$ref": "#/components/schemas/Foo"
                                   }
                            ],
                            "properties": {
                                   "c": {
                                          "$ref": "#/components/schemas/mobidp.adapters.Duration"
                                   }
                            }
                     },
                     "mobidp.common.Geometry": {
                            "description": "My Geometry",
                            "oneOf": [
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.Point"
                                   },
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.MultiPoint"
                                   },
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.LineString"
                                   },
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.MultiLineString"
                                   },
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.Polygon"
                                   },
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.MultiPolygon"
                                   }
                            ],
                            "discriminator": {
                                   "propertyName": "type",
                                   "mapping": {
                                          "Point": "#/components/schemas/mobidp.common.Point",
                                          "MultiPoint": "#/components/schemas/mobidp.common.MultiPoint",
                                          "LineString": "#/components/schemas/mobidp.common.LineString",
                                          "MultiLineString": "#/components/schemas/mobidp.common.MultiLineString",
                                          "Polygon": "#/components/schemas/mobidp.common.Polygon",
                                          "MultiPolygon": "#/components/schemas/mobidp.common.MultiPolygon"
                                   }
                            }
                     },
                     "Baz": {
                            "type": "array",
                            "items": {
                                   "type": "object",
                                   "additionalProperties": {
                                          "$ref": "#/components/schemas/mobidp.common.String"
                                   }
                            }
                     },
                     "mobidp.common.Decimal": {
                            "description": "Decimal number",
                            "type": "number"
                     },
                     "number-foo": {
                            "title": "Foo",
                            "type": "number"
                     },
                     "number-bar": {
                            "title": "Bar",
                            "type": "number"
                     },
                     "number-baz": {
                            "title": "Baz",
                            "allOf": [
                                   {
                                          "$ref": "#/components/schemas/mobidp.common.Decimal"
                                   }
                            ]
                     },
                     "mobidp.persistence.ValueObject": {
                            "type": "object"
                     },
                     "BaseA": {
                            "type": "object",
                            "allOf": [
                                   {
                                          "$ref": "#/components/schemas/mobidp.persistence.ValueObject"
                                   }
                            ],
                            "properties": {
                                   "@type": {
                                          "enum": [
                                                 "BaseA$Bean",
                                                 "DerivedA1$Bean",
                                                 "DerivedA2$Bean"
                                          ],
                                          "default": "BaseA$Bean"
                                   },
                                   "name": {
                                          "type": "string"
                                   }
                            }
                     },
                     "DerivedA1": {
                            "type": "object",
                            "allOf": [
                                   {
                                          "$ref": "#/components/schemas/BaseA"
                                   }
                            ],
                            "properties": {
                                   "@type": {
                                          "enum": [
                                                 "DerivedA1$Bean"
                                          ],
                                          "default": "DerivedA1$Bean"
                                   },
                                   "value": {
                                          "type": "string"
                                   }
                            }
                     },
                     "DerivedA2": {
                            "type": "object",
                            "allOf": [
                                   {
                                          "$ref": "#/components/schemas/BaseA"
                                   }
                            ],
                            "properties": {
                                   "@type": {
                                          "enum": [
                                                 "DerivedA2$Bean"
                                          ],
                                          "default": "DerivedA2$Bean"
                                   }
                            }
                     }
              }
       }
}
