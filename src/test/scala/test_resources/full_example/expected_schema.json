{
       "$schema": "http://json-schema.org/draft-07/schema",
       "type": "object",
       "anyOf": [
              {
                     "$ref": "#/definitions/mobidp.adapters.String"
              },
              {
                     "$ref": "#/definitions/mobidp.adapters.Duration"
              }
       ],
       "definitions": {
              "mobidp.common.String": {
                     "type": "string"
              },
              "mobidp.common.Duration": {
                     "type": [
                            "number",
                            "string"
                     ],
                     "pattern": "^P([0-9]+D)?T([0-9]+H)?([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?$"
              },
              "mobidp.common.Geometry": {
                     "description": "My Geometry",
                     "oneOf": [
                            {
                                   "$ref": "#/definitions/mobidp.common.Point"
                            },
                            {
                                   "$ref": "#/definitions/mobidp.common.MultiPoint"
                            },
                            {
                                   "$ref": "#/definitions/mobidp.common.LineString"
                            },
                            {
                                   "$ref": "#/definitions/mobidp.common.MultiLineString"
                            },
                            {
                                   "$ref": "#/definitions/mobidp.common.Polygon"
                            },
                            {
                                   "$ref": "#/definitions/mobidp.common.MultiPolygon"
                            }
                     ],
                     "discriminator": {
                            "propertyName": "type",
                            "mapping": {
                                   "Point": "#/definitions/mobidp.common.Point",
                                   "MultiPoint": "#/definitions/mobidp.common.MultiPoint",
                                   "LineString": "#/definitions/mobidp.common.LineString",
                                   "MultiLineString": "#/definitions/mobidp.common.MultiLineString",
                                   "Polygon": "#/definitions/mobidp.common.Polygon",
                                   "MultiPolygon": "#/definitions/mobidp.common.MultiPolygon"
                            }
                     }
              },
              "KStoreValue": {
                     "oneOf": [
                            {
                                   "$ref": "#/definitions/BaseA"
                            },
                            {
                                   "$ref": "#/definitions/DerivedA1"
                            },
                            {
                                   "$ref": "#/definitions/DerivedA2"
                            }
                     ],
                     "discriminator": {
                            "propertyName": "@type",
                            "mapping": {
                                   "BaseA$Bean": "#/definitions/BaseA",
                                   "DerivedA1$Bean": "#/definitions/DerivedA1",
                                   "DerivedA2$Bean": "#/definitions/DerivedA2"
                            }
                     }
              },
              "Foo": {
                     "type": "object",
                     "properties": {
                            "a": {
                                   "type": "string"
                            },
                            "b": {
                                   "type": "number"
                            }
                     }
              },
              "Bar": {
                     "type": "object",
                     "allOf": [
                            {
                                   "$ref": "#/definitions/Foo"
                            }
                     ],
                     "properties": {
                            "c": {
                                   "$ref": "#/definitions/mobidp.adapters.Duration"
                            }
                     }
              },
              "Baz": {
                     "type": "array",
                     "items": {
                            "type": "object",
                            "additionalProperties": {
                                   "$ref": "#/definitions/mobidp.common.String"
                            }
                     }
              },
              "mobidp.common.Decimal": {
                     "description": "Decimal number",
                     "type": "number"
              },
              "number-foo": {
                     "title": "Foo",
                     "type": "number"
              },
              "number-bar": {
                     "title": "Bar",
                     "type": "number"
              },
              "number-baz": {
                     "title": "Baz",
                     "allOf": [
                            {
                                   "$ref": "#/definitions/mobidp.common.Decimal"
                            }
                     ]
              },
              "mobidp.persistence.ValueObject": {
                     "type": "object"
              },
              "BaseA": {
                     "type": "object",
                     "allOf": [
                            {
                                   "$ref": "#/definitions/mobidp.persistence.ValueObject"
                            }
                     ],
                     "properties": {
                            "@type": {
                                   "enum": [
                                          "BaseA$Bean",
                                          "DerivedA1$Bean",
                                          "DerivedA2$Bean"
                                   ],
                                   "default": "BaseA$Bean"
                            },
                            "name": {
                                   "type": "string"
                            }
                     }
              },
              "DerivedA1": {
                     "type": "object",
                     "allOf": [
                            {
                                   "$ref": "#/definitions/BaseA"
                            }
                     ],
                     "properties": {
                            "@type": {
                                   "enum": [
                                          "DerivedA1$Bean"
                                   ],
                                   "default": "DerivedA1$Bean"
                            },
                            "value": {
                                   "type": "string"
                            }
                     }
              },
              "DerivedA2": {
                     "type": "object",
                     "allOf": [
                            {
                                   "$ref": "#/definitions/BaseA"
                            }
                     ],
                     "properties": {
                            "@type": {
                                   "enum": [
                                          "DerivedA2$Bean"
                                   ],
                                   "default": "DerivedA2$Bean"
                            }
                     }
              }
       }
}
